{
  "$schema": "https://turbo.build/schema.json",
  "envMode": "loose",
  "tasks": {
    "build:android": {
      "env": ["ORG_GRADLE_PROJECT_newArchEnabled"],
      "inputs": [
        "package.json",
        "src/**",
        "android/**",
        "!android/.gradle/**",
        "!android/build/**",
        "!android/app/build/**",
        "!android/app/.cxx/**",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/src/**",
        "$TURBO_ROOT$/android/**",
        "!$TURBO_ROOT$/android/build/**",
        "!$TURBO_ROOT$/android/.gradle/**"
      ],
      "outputs": []
    },
    "build:ios": {
      "env": ["RCT_NEW_ARCH_ENABLED"],
      "inputs": [
        "package.json",
        "src/**",
        "ios/**",
        "!ios/build/**",
        "!ios/Pods/**",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/*.podspec",
        "$TURBO_ROOT$/src/**",
        "$TURBO_ROOT$/ios/**",
        "!$TURBO_ROOT$/ios/.build/**"
      ],
      "outputs": []
    }
  }
}
